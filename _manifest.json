{
  "manifest_version": 2,
  "id": "arcdent.repeater-plugin",
  "version": "0.9.1",
  "name": "复读插件",
  "description": "复读链达标后按权重掷骰复读、打断或沉默，表情回应按概率跟风或贴反义",
  "author": {
    "name": "arcdent",
    "url": "https://github.com/arcdent"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/arcdent/repeater-plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0"
    }
  ],
  "capabilities": [
    "maisaka.context.append",
    "chat.get_stream_by_group_id",
    "config.get",
    "chat.receive.before_process"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
