{
  "manifest_version": 2,
  "id": "arcdent.repeater-plugin",
  "version": "0.4.0",
  "name": "复读插件",
  "description": "群内同一句复读接龙达标后，麦麦按概率复读原文或发打断文本唱反调；有人给消息贴表情回应后，麦麦按概率跟着贴同款或语义相反的表情",
  "author": {
    "name": "arcdent",
    "url": "https://github.com/arcdent"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/arcdent/sending-emojis-plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0"
    }
  ],
  "capabilities": [
    "maisaka.context.append",
    "chat.get_stream_by_group_id",
    "config.get",
    "chat.receive.before_process"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  }
}